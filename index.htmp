<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A-Frame Demo</title>

    <!-- A-Frame Library -->
    <script src="https://aframe.io/releases/1.7.1/aframe.min.js"></script>
</head>

<body>
    <a-scene>

        <!-- Red Box -->
        <a-box
            position="-1 1 -3"
            color="red">
        </a-box>

        <!-- Blue Sphere -->
        <a-sphere
            position="1 1 -4"
            radius="0.5"
            color="blue">
        </a-sphere>

        <!-- Ground -->
        <a-plane
            position="0 0 -4"
            rotation="-90 0 0"
            width="10"
            height="10"
            color="#DDDDDD">
        </a-plane>

        <!-- Sky -->
        <a-sky color="#EEEEEE"></a-sky>

        <!-- Camera -->
        <a-camera position="0 1.6 0"></a-camera>

    </a-scene>
</body>
</html>

