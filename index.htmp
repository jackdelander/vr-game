<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A-Frame Demo</title>

    <!-- A-Frame Library -->
    <script src="https://aframe.io/releases/1.7.1/aframe.min.js"></script>
</head>

<body style="margin:0; overflow:hidden;">

    <a-scene>

        <!-- Sky -->
        <a-sky color="#87CEEB"></a-sky>

        <!-- Ground -->
        <a-plane
            position="0 0 -4"
            rotation="-90 0 0"
            width="50"
            height="50"
            color="#3CB043">
        </a-plane>

        <!-- Box -->
        <a-box
            position="-1 1 -5"
            rotation="0 45 0"
            color="#FF0000">
        </a-box>

        <!-- Sphere -->
        <a-sphere
            position="1 1.25 -4"
            radius="0.75"
            color="#4287f5">
        </a-sphere>

        <!-- Cylinder -->
        <a-cylinder
            position="3 1 -6"
            radius="0.5"
            height="2"
            color="#FFC65D">
        </a-cylinder>

        <!-- Light -->
        <a-light
            type="directional"
            intensity="1"
            position="1 3 2">
        </a-light>

        <a-light
            type="ambient"
            intensity="0.5">
        </a-light>

        <!-- Camera -->
        <a-camera
            position="0 1.6 5"
            wasd-controls
            look-controls>
        </a-camera>

    </a-scene>

</body>
</html>
